{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "core",
  "version": "0.2.1",
  "identifier": "com.posma.app",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "POSMA",
        "minWidth": 1600,
        "minHeight": 900,
        "width": 1600,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/big-files",
      "binaries/browser-hygiene",
      "binaries/disk-map",
      "binaries/duplicates",
      "binaries/health-monitor",
      "binaries/metadata",
      "binaries/shredder",
      "binaries/system-info",
      "binaries/temp-clean",
      "binaries/vault"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
